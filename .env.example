# TeamFlow Backend Environment Configuration

# Server network settings
PORT=2811
NODE_ENV=development

# Database connection
MONGODB_URI=mongodb://localhost:27017/teamflow

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:2004

# JWT Secrets & Expirations
JWT_ACCESS_SECRET=teamflow-super-secret-access-key-change-in-prod
JWT_REFRESH_SECRET=teamflow-super-secret-refresh-key-change-in-prod
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
